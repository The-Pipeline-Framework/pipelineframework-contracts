<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pipelineframework</groupId>
        <artifactId>pipelineframework-contracts-parent</artifactId>
        <version>26.11.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pipelineframework-api</artifactId>
    <name>The Pipeline Framework API</name>
    <description>Framework-neutral authored discovery and generated-name contracts</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
            <resource><directory>src/main/build-metadata</directory><filtering>true</filtering></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-packaged-contracts-version</id>
                        <phase>verify</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <loadproperties prefix="contracts.jar">
                                    <zipentry zipfile="${project.build.directory}/${project.build.finalName}.jar"
                                              name="META-INF/tpf/contracts-version.properties"/>
                                </loadproperties>
                                <fail message="API JAR is missing contracts version metadata or its version does not match ${project.version}">
                                    <condition>
                                        <not>
                                            <equals arg1="${contracts.jar.version}" arg2="${project.version}"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-portable-api-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.pipelineframework:*</exclude>
                                        <exclude>io.quarkus:*</exclude>
                                        <exclude>jakarta.enterprise:*</exclude>
                                        <exclude>jakarta.inject:*</exclude>
                                        <exclude>javax.enterprise:*</exclude>
                                        <exclude>javax.inject:*</exclude>
                                        <exclude>org.jboss.weld:*</exclude>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.*:*</exclude>
                                        <exclude>com.fasterxml.jackson.*:*</exclude>
                                        <exclude>com.google.protobuf:*</exclude>
                                        <exclude>io.smallrye.reactive:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
